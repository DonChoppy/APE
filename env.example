# =============================================================================
# APE (Agentic Protocol Executor) Configuration
# =============================================================================
# Copy this file to .env and adjust the values according to your setup

# -----------------------------------------------------------------------------
# Security (REQUIRED)
# -----------------------------------------------------------------------------
# Shared secret used to sign/verify tool results via JWT (HS256)
# IMPORTANT: Change this to a secure random string in production
MCP_JWT_KEY=please-change-me-to-a-secure-random-string

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
# HTTP port for MCP server
PORT=8000

# Root log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# URLs of the MCP servers to connect to
# In Gateway setup, we only connect to the Core Server.
MCP_SERVER_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Ollama / LLM Configuration
# -----------------------------------------------------------------------------
# Base URL of the local Ollama server
OLLAMA_BASE_URL=http://localhost:11434

# Main LLM model name for reasoning and complex tasks
LLM_MODEL=qwen3:8b

# Smaller, faster model for simple tasks via call_slm tool
SLM_MODEL=qwen3:0.6b

# Model for text embeddings
EMBEDDING_MODEL=embeddinggemma:latest

# Embedding dimension size (leave empty for auto-detection)
# EMBEDDING_SIZE=

# LLM sampling temperature (0.0 = deterministic, 1.0 = creative)
TEMPERATURE=0.5

# Nucleus sampling parameter - probability mass to consider
TOP_P=0.9

# Top-K sampling - number of token candidates to consider
TOP_K=40

# Maximum reasoning/tool use iterations per user prompt
MAX_TOOLS_ITERATIONS=15

# Manual cap for the LLM context window (tokens)
# For 6GB VRAM, 8192 or 4096 is recommended. Leave empty to detect from model metadata.
# CONTEXT_WINDOW=8192

# -----------------------------------------------------------------------------
# UI / CLI Options
# -----------------------------------------------------------------------------
# CLI theme (dark or light)
UI_THEME=dark

# Whether to stream the model's <think> content to the console
SHOW_THOUGHTS=true

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# Path to SQLite database that stores message history
SESSION_DB_PATH=database/sessions.db

# -----------------------------------------------------------------------------
# Vector Memory Configuration
# -----------------------------------------------------------------------------
# Path to directory for vector memory files (FAISS index and metadata)
VECTOR_DB_PATH=database/vector_memory

# Number of results to return from vector search
VECTOR_SEARCH_TOP_K=5

# Enable reranking of vector search results (experimental)
VECTOR_SEARCH_RERANK=false

# -----------------------------------------------------------------------------
# Memory / Summarization
# -----------------------------------------------------------------------------
# Safety buffer deducted from model context length before pruning
CONTEXT_MARGIN_TOKENS=1024

# Include <think> blocks in summarization (true/false)
SUMMARIZE_THOUGHTS=false

# Default maximum length (in tokens) for summaries (32-8192)
SUMMARY_MAX_TOKENS=128

# -----------------------------------------------------------------------------
# Advanced / Optional
# -----------------------------------------------------------------------------
# Disable hot-reload of prompt templates (set to 1 to disable)
# APE_DISABLE_PROMPT_WATCH=0